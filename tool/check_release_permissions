#!/usr/bin/env bash
# Builds the release APK and checks its merged manifest: no forbidden
# permission (INTERNET and the media permissions TakeTray never asks for),
# Google backup off (D-64) and, once ENFORCE_MEDIA_PERMISSIONS is on, exactly
# the media permissions TakeTray needs. Slow (full release build), so it is not
# part of tool/check; run it at the end of every phase. Steps are documented in
# docs/flow.md ("Release permission check").
set -euo pipefail

cd "$(dirname "$0")/.."

SDK="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
BUILD_TOOLS="$SDK/build-tools"

# Newest stable build-tools (x.y.z) that ships aapt2.
latest=""
if [ -d "$BUILD_TOOLS" ]; then
  while IFS= read -r v; do
    [ -x "$BUILD_TOOLS/$v/aapt2" ] && latest="$v"
  done < <(ls "$BUILD_TOOLS" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V)
fi
if [ -z "$latest" ]; then
  echo "No Android build-tools with aapt2 found in $BUILD_TOOLS" >&2
  exit 1
fi
AAPT2="$BUILD_TOOLS/$latest/aapt2"
echo "Using aapt2 from build-tools $latest"

(cd app && ../tool/flutter build apk --release)

APK="app/build/app/outputs/flutter-apk/app-release.apk"
if [ ! -f "$APK" ]; then
  echo "Release APK not found: $APK" >&2
  exit 1
fi

permissions="$("$AAPT2" dump permissions "$APK")"
manifest="$("$AAPT2" dump xmltree --file AndroidManifest.xml "$APK")"

# Reduce the manifest dump to the lines this check needs:
#   application <attribute> <value>      for each attribute of <application>
#   permission <name> <maxSdkVersion|->  for each <uses-permission>
facts="$(awk '
  /^ *E: / { element = $2; perm = ""; next }
  /^ *A: / {
    line = $0
    sub(/^ *A: /, "", line)
    attr = line
    sub(/\(0x[0-9a-f]+\).*$/, "", attr)
    sub(/^.*\/android:/, "", attr)
    value = line
    sub(/^[^=]*=/, "", value)
    sub(/ \(Raw: .*$/, "", value)
    gsub(/"/, "", value)
    if (element == "application") print "application", attr, value
    if (element == "uses-permission" || element == "uses-permission-sdk-23") {
      if (attr == "name") { perm = value; names[perm] = 1; max[perm] = "-" }
      if (attr == "maxSdkVersion" && perm != "") max[perm] = value
    }
  }
  END { for (n in names) print "permission", n, max[n] }
' <<<"$manifest")"

problems=()

# A parse that found nothing must not look like "nothing forbidden". The release
# manifest always has at least one uses-permission (the plugins add some), so
# zero facts means the xmltree format changed or the awk pass broke.
if ! grep -q '^permission ' <<<"$facts"; then
  problems+=("no permissions were parsed from the manifest dump (aapt2 xmltree format changed?)")
fi
if ! grep -q '^application ' <<<"$facts"; then
  problems+=("no <application> attributes were parsed from the manifest dump (aapt2 xmltree format changed?)")
fi

# --- Google backup is off (D-64). ---
app_attr() { awk -v a="$1" '$1 == "application" && $2 == a { print $3 }' <<<"$facts"; }
if [ "$(app_attr allowBackup)" != "false" ]; then
  problems+=("allowBackup is not false (found: '$(app_attr allowBackup)')")
fi
if [ -z "$(app_attr dataExtractionRules)" ]; then
  problems+=("dataExtractionRules is not set")
fi
if [ -z "$(app_attr fullBackupContent)" ]; then
  problems+=("fullBackupContent is not set")
fi

# --- Permissions that must never be in the release build. ---
FORBIDDEN_PERMISSIONS=(
  android.permission.INTERNET
  android.permission.READ_MEDIA_IMAGES
  android.permission.MANAGE_EXTERNAL_STORAGE
  android.permission.ACCESS_MEDIA_LOCATION
)
for p in "${FORBIDDEN_PERMISSIONS[@]}"; do
  if awk -v p="$p" '$1 == "permission" && $2 == p { found = 1 } END { exit !found }' <<<"$facts"; then
    problems+=("$p permission found in release build")
  elif grep -qF "name='$p'" <<<"$permissions"; then
    # Second opinion: aapt2's own permission list, in case the xmltree parse missed it.
    problems+=("$p permission found in release build (aapt2 dump permissions)")
  fi
done

# --- Media permissions that must be there (name:maxSdkVersion, '-' = no max). ---
# Off until Task 4 of phase 3 adds them to the manifest; that task sets the
# default to 1. Run with ENFORCE_MEDIA_PERMISSIONS=1 to try it earlier.
ENFORCE_MEDIA_PERMISSIONS="${ENFORCE_MEDIA_PERMISSIONS:-0}"
REQUIRED_PERMISSIONS=(
  android.permission.READ_MEDIA_VIDEO:-
  android.permission.READ_MEDIA_VISUAL_USER_SELECTED:-
  android.permission.READ_EXTERNAL_STORAGE:32
)
if [ "$ENFORCE_MEDIA_PERMISSIONS" = "1" ]; then
  for entry in "${REQUIRED_PERMISSIONS[@]}"; do
    name="${entry%%:*}"
    want="${entry##*:}"
    have="$(awk -v p="$name" '$1 == "permission" && $2 == p { print $3 }' <<<"$facts")"
    if [ -z "$have" ]; then
      problems+=("$name permission is missing")
    elif [ "$have" != "$want" ]; then
      problems+=("$name has maxSdkVersion '$have', expected '$want'")
    fi
  done
fi

if [ "${#problems[@]}" -gt 0 ]; then
  echo "$permissions" >&2
  for problem in "${problems[@]}"; do
    echo "RELEASE CHECK FAILED: $problem" >&2
  done
  exit 1
fi

echo "$permissions"
echo "RELEASE PERMISSIONS OK"
