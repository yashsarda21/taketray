#!/usr/bin/env bash
# One-command local check. Stops at the first failure.
# Steps are documented in docs/flow.md ("Local checks").
set -euo pipefail

EXPECTED_FLUTTER="3.47.7"

# Every member of the pub workspace must be listed in exactly one of these.
# A listed member whose pubspec.yaml is missing fails the check (a rename or
# deletion must not pass silently).
FLUTTER_MEMBERS=(app packages/taketray_ui widgetbook)
DART_MEMBERS=(tool)

# The Flutter member whose tests run with --coverage (see the coverage step).
COVERAGE_MEMBER=app

# Folders (relative to $COVERAGE_MEMBER) that need at least 80 % line coverage.
# A `*` is exactly one path segment. A prefix may match no folder yet (see
# tool/bin/check_coverage.dart). Every non-generated .dart file under these is
# imported by a generated test, so one that no test loads still counts.
COVERAGE_PREFIXES=(
  lib/domain/
  lib/data/
  lib/platform/
  'lib/features/*/view_models/'
)

# Written for the coverage test run only, and deleted when check exits.
COVERAGE_IMPORTS_FILE="app/test/_coverage_imports_test.dart"

# Folders that the style rules (docs/flow.md, D-19) apply to.
STYLE_DIRS=(app/lib/features packages/taketray_ui/lib/src/components)

# Test files with daylight-saving cases that only hold in Europe/London (they
# skip themselves in any other zone). Paths are relative to $DST_MEMBER. The
# step "daylight-saving tests" runs them again in that zone (D-69).
DST_MEMBER=app
DST_TESTS=(test/domain/rules/earlier_window_test.dart)

cd "$(dirname "$0")/.."
root="$(pwd)"

# A file left behind by a killed run would be formatted and analyzed below.
rm -f "$COVERAGE_IMPORTS_FILE"
trap 'rm -f "$root/$COVERAGE_IMPORTS_FILE"' EXIT

step() { printf '\n==> %s\n' "$*"; }

in_list() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

# A member in both lists would be analyzed and tested twice, and with the wrong
# tool for one of them.
for m in "${FLUTTER_MEMBERS[@]}"; do
  if in_list "$m" "${DART_MEMBERS[@]}"; then
    echo "FAIL: member $m is listed in both FLUTTER_MEMBERS and DART_MEMBERS in tool/check; it must be in exactly one" >&2
    exit 1
  fi
done

# Writes $COVERAGE_IMPORTS_FILE: one empty test that imports every
# non-generated .dart file under COVERAGE_PREFIXES. lcov only lists files that
# some test loads, so without this a file nobody tests would not count against
# the total at all.
write_coverage_imports() {
  local prefix dir file before counts=""
  local files=()
  shopt -s nullglob
  for prefix in "${COVERAGE_PREFIXES[@]}"; do
    before=${#files[@]}
    # Unquoted on purpose: a `*` in the prefix expands to one path segment.
    for dir in $COVERAGE_MEMBER/$prefix; do
      [ -d "$dir" ] || continue
      while IFS= read -r file; do
        # A part file cannot be imported; its library file is.
        grep -q '^part of ' "$file" && continue
        files+=("$file")
      done < <(find "$dir" -type f -name '*.dart' ! -name '*.g.dart' ! -name '*.freezed.dart')
    done
    counts+="${counts:+, }$prefix $((${#files[@]} - before)) files"
  done
  shopt -u nullglob
  {
    echo "// GENERATED by tool/check for the coverage run. Never committed."
    echo "// ignore_for_file: unused_import, directives_ordering, depend_on_referenced_packages"
    echo "import 'package:flutter_test/flutter_test.dart';"
    if [ "${#files[@]}" -gt 0 ]; then
      printf '%s\n' "${files[@]}" | LC_ALL=C sort -u |
        sed -e "s|^$COVERAGE_MEMBER/lib/|import 'package:taketray/|" -e "s|\$|';|"
    fi
    echo
    echo "void main() {"
    echo "  test('loads every file under the coverage prefixes', () {});"
    echo "}"
  } >"$root/$COVERAGE_IMPORTS_FILE"
  # One count per prefix, so a glob that matches nothing shows in the log.
  echo "coverage imports: $counts"
}

step "workspace members"
# The `workspace:` list in the root pubspec.yaml: the `  - x` lines after
# `workspace:`. Blank and comment lines inside the list are skipped; the list
# ends at the next top-level key (a non-indented, non-comment line).
members=()
while IFS= read -r line; do
  members+=("$line")
done < <(awk '
  /^workspace:/ { in_list = 1; next }
  in_list && /^  - / {
    sub(/^  - /, "")
    sub(/[ \t]*(#.*)?$/, "")
    gsub(/["'\'']/, "")
    print
    next
  }
  in_list && /^[ \t]*(#.*)?$/ { next }
  in_list && /^[^ \t#]/ { exit }
' pubspec.yaml)
if [ "${#members[@]}" -eq 0 ]; then
  echo "no workspace members found in pubspec.yaml" >&2
  exit 1
fi
for m in "${members[@]}"; do
  if ! in_list "$m" "${FLUTTER_MEMBERS[@]}" "${DART_MEMBERS[@]}"; then
    echo "workspace member $m is not covered by tool/check" >&2
    exit 1
  fi
done
echo "Workspace members: ${members[*]}"

# Every listed member must exist: a missing one fails the check.
flutter_present=()
for m in "${FLUTTER_MEMBERS[@]}"; do
  if [ ! -f "$m/pubspec.yaml" ]; then
    echo "FAIL: Flutter member $m is listed in tool/check but $m/pubspec.yaml is missing" >&2
    exit 1
  fi
  flutter_present+=("$m")
done
dart_present=()
for m in "${DART_MEMBERS[@]}"; do
  if [ ! -f "$m/pubspec.yaml" ]; then
    echo "FAIL: Dart member $m is listed in tool/check but $m/pubspec.yaml is missing" >&2
    exit 1
  fi
  dart_present+=("$m")
done

for d in "${STYLE_DIRS[@]}"; do
  if [ ! -d "$d" ]; then
    echo "FAIL: style directory $d is listed in tool/check but does not exist" >&2
    exit 1
  fi
done

for t in "${DST_TESTS[@]}"; do
  if [ ! -f "$DST_MEMBER/$t" ]; then
    echo "FAIL: daylight-saving test $DST_MEMBER/$t is listed in tool/check but does not exist" >&2
    exit 1
  fi
done

step "SDK version"
version_output="$(tool/flutter --version 2>&1)"
if ! grep -qF "Flutter ${EXPECTED_FLUTTER} " <<<"$version_output"; then
  echo "Expected Flutter ${EXPECTED_FLUTTER}, got:" >&2
  echo "$version_output" >&2
  exit 1
fi
echo "Flutter ${EXPECTED_FLUTTER}"

step "pub get"
tool/flutter pub get

step "generated files fresh"
# Fails when a committed *.g.dart / *.freezed.dart / drift_schemas file differs
# from what build_runner writes now (D-53).
tool/check_generated

step "design tokens fresh"
# Fails when a generated token file (Dart, CSS, JSON, Kotlin) differs from
# what design/tools/build_tokens.py would write (D-35).
python3 design/tools/build_tokens.py --check

step "format"
format_paths=()
for m in "${flutter_present[@]}"; do
  for d in lib test patrol_test; do
    [ -e "$m/$d" ] && format_paths+=("$m/$d")
  done
done
for m in "${dart_present[@]}"; do
  format_paths+=("$m")
done
tool/dart format --output=none --set-exit-if-changed "${format_paths[@]}"

for m in "${flutter_present[@]}"; do
  step "analyze $m"
  (cd "$m" && "$root/tool/flutter" analyze)
done
for m in "${dart_present[@]}"; do
  step "analyze $m"
  (cd "$m" && "$root/tool/dart" analyze --fatal-infos)
done

for d in "${STYLE_DIRS[@]}"; do
  step "style rules ($d)"
  tool/dart run taketray_tool:check_styles "$d"
done

for m in "${dart_present[@]}"; do
  step "test $m"
  if [ ! -d "$m/test" ]; then
    echo "$m has no test/ folder" >&2
    exit 1
  fi
  (cd "$m" && "$root/tool/dart" test)
done
for m in "${flutter_present[@]}"; do
  step "test $m"
  if [ ! -d "$m/test" ]; then
    echo "$m has no test/ folder" >&2
    exit 1
  fi
  if [ "$m" = "$COVERAGE_MEMBER" ]; then
    write_coverage_imports
    # Also writes $m/coverage/lcov.info for the coverage step below.
    (cd "$m" && "$root/tool/flutter" test --coverage)
    rm -f "$root/$COVERAGE_IMPORTS_FILE"
  else
    (cd "$m" && "$root/tool/flutter" test)
  fi
done

step "daylight-saving tests (TZ=Europe/London)"
# The London-only cases skip in the run above unless the machine is in
# London. Here they run in that zone, and --run-skipped means they can never
# skip: if TZ did not take effect, they fail instead of passing silently.
(cd "$DST_MEMBER" && TZ=Europe/London "$root/tool/flutter" test --run-skipped "${DST_TESTS[@]}")

step "android unit tests"
# The Kotlin media bridge, with Robolectric on the JVM (D-67). Needs a JDK and
# the Android SDK; see tool/test_android.
tool/test_android

step "coverage (domain, data, platform, view models)"
# At least 80 % of the lines under each prefix must run in a test (generated
# files are not counted). Prefixes that match no file yet pass with "no files".
tool/dart run taketray_tool:check_coverage "$COVERAGE_MEMBER/coverage/lcov.info" 80 \
  "${COVERAGE_PREFIXES[@]}"

printf '\nALL CHECKS PASSED\n'
