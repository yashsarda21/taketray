#!/usr/bin/env bash
# Makes the video the on-device tests put into the phone's media library
# (phase 3, Task 11, D-77) and writes it as a base64 Dart constant to
# app/patrol_test/fixtures/test_video.dart.
#
# The video: 2 seconds, 160x90, 15 frames per second, H.264 (libx264, High
# profile, yuv420p) in an MP4, ffmpeg's `testsrc2` test pattern, no audio. A
# few KB, so the constant is small and the file is a real video that Android's
# media scanner and thumbnail code accept.
#
# Deterministic for one ffmpeg build: one encoder thread, no metadata, no
# encoder or muxer version string and no creation time (`-fflags +bitexact`),
# so running it again gives the same bytes. A different ffmpeg or libx264 build
# can give different bytes (x264 writes its own version into the stream); the
# committed file then differs after a re-run, which is harmless: the tests only
# need a valid video.
#
# Refuses to touch the output when ffmpeg is missing or fails: the new file is
# built beside the old one and moved over it only when complete.
#
# Usage: tool/make_test_video            (writes the fixture)
#        tool/make_test_video --check    (writes nothing; fails when the
#                                         committed fixture differs)
set -euo pipefail

cd "$(dirname "$0")/.."

OUT="app/patrol_test/fixtures/test_video.dart"
mode="write"
case "${1:-}" in
  "") ;;
  --check) mode="check" ;;
  *)
    echo "usage: tool/make_test_video [--check]" >&2
    exit 2
    ;;
esac

FFMPEG="${FFMPEG:-}"
if [ -z "$FFMPEG" ]; then
  if command -v ffmpeg >/dev/null 2>&1; then
    FFMPEG="$(command -v ffmpeg)"
  elif [ -x /opt/homebrew/bin/ffmpeg ]; then
    FFMPEG=/opt/homebrew/bin/ffmpeg
  fi
fi
if [ -z "$FFMPEG" ] || [ ! -x "$FFMPEG" ]; then
  echo "ffmpeg not found (looked on PATH and in /opt/homebrew/bin). Install it (brew install ffmpeg) or set FFMPEG=/path/to/ffmpeg. $OUT was not touched." >&2
  exit 1
fi
if ! "$FFMPEG" -hide_banner -encoders 2>/dev/null | grep -q ' libx264 '; then
  echo "This ffmpeg has no libx264 encoder. $OUT was not touched." >&2
  exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

"$FFMPEG" -hide_banner -loglevel error -y \
  -f lavfi -i "testsrc2=size=160x90:rate=15:duration=2" \
  -an \
  -c:v libx264 -preset medium -crf 28 -profile:v high -pix_fmt yuv420p \
  -threads 1 -x264-params "threads=1:sliced-threads=0" \
  -fflags +bitexact -flags:v +bitexact -map_metadata -1 \
  -movflags +faststart \
  -f mp4 "$work/test_video.mp4"

size="$(wc -c <"$work/test_video.mp4" | tr -d ' ')"
if [ "$size" -lt 1000 ] || [ "$size" -gt 100000 ]; then
  echo "unexpected video size: $size bytes. $OUT was not touched." >&2
  exit 1
fi

# 72 characters per line: with the indent and quotes the lines stay under 80.
base64 <"$work/test_video.mp4" | tr -d '\n' | fold -w 72 >"$work/chunks.txt"
printf '\n' >>"$work/chunks.txt"

{
  echo "// GENERATED by tool/make_test_video. Do not edit by hand."
  echo "//"
  echo "// A 2 second, 160x90, H.264 test pattern (no audio), $size bytes. The"
  echo "// on-device tests put it into the phone's media library (D-77)."
  echo
  echo "import 'dart:convert';"
  echo "import 'dart:typed_data';"
  echo
  echo "/// The test video's MP4 bytes."
  echo "Uint8List get testVideoBytes => base64Decode(_testVideoBase64);"
  echo
  echo "const String _testVideoBase64 ="
  sed -e "s/^/    '/" -e "s/\$/'/" "$work/chunks.txt" | sed -e '$ s/$/;/'
} >"$work/test_video.dart"

# Same formatting as the rest of patrol_test, so tool/check's format step
# passes without a second pass.
tool/dart format "$work/test_video.dart" >/dev/null

if [ "$mode" = "check" ]; then
  if cmp -s "$work/test_video.dart" "$OUT"; then
    echo "$OUT is up to date ($size bytes of video)"
    exit 0
  fi
  echo "$OUT differs from what this ffmpeg makes (a different ffmpeg build gives different bytes)" >&2
  exit 1
fi

mkdir -p "$(dirname "$OUT")"
mv "$work/test_video.dart" "$OUT"
echo "Wrote $OUT ($size bytes of video)"
