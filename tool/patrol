#!/usr/bin/env bash
# Runs patrol_cli with the pinned Flutter (never the old `flutter` on PATH).
# Usage: tool/patrol <patrol args>, from any directory; test commands run in app/.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
flutter_bin="$HOME/development/flutter/bin"
patrol_bin="$HOME/.pub-cache/bin/patrol"

if [ ! -x "$patrol_bin" ]; then
  echo "patrol_cli is not installed. Run: tool/dart pub global activate patrol_cli" >&2
  exit 1
fi

# The app is fully offline: no usage data leaves this machine.
export PATROL_ANALYTICS_ENABLED=false
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
export PATH="$flutter_bin:$ANDROID_HOME/platform-tools:$HOME/.pub-cache/bin:$PATH"
cd "$root/app"
# patrol_cli writes a generated patrol_test/test_bundle.dart (git-ignored); remove it
# afterwards so tool/check's format and analyze steps never see it.
trap 'rm -f patrol_test/test_bundle.dart' EXIT
"$patrol_bin" --flutter-command "$flutter_bin/flutter" "$@"
