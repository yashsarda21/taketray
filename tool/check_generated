#!/usr/bin/env bash
# Fails when committed generated files are stale (D-53).
#
# For every member whose pubspec.yaml has build_runner or pigeon in
# dev_dependencies (or only the members named as arguments), it hashes the
# generated files, deletes the *.g.dart / *.freezed.dart / *.g.kt ones, the
# drift step helpers (lib/**/*.steps.dart) and the drift schema helpers
# (test/drift/*/generated/), regenerates everything (Pigeon for each
# pigeons/*.dart, then build_runner, then drift_dev make-migrations), hashes
# again and reports every file that changed, appeared or disappeared. The
# schema dumps in drift_schemas/ and the hand-written tests in test/drift/*/
# (migration_test.dart, which make-migrations writes only once, and
# schema_test.dart) are hashed but never deleted (D-54, D-120). It
# compares hashes, not `git status`, so a dirty working tree does not cause a
# false failure; it checks the working tree, not what is committed. Run
# `tool/flutter pub get` first (tool/check does).
# Steps: docs/flow.md ("Generated-file freshness").
set -euo pipefail

cd "$(dirname "$0")/.."
root="$(pwd)"

# True when the pubspec $1 lists package $2 under dev_dependencies (not under
# dependencies or dependency_overrides).
has_dev_dependency() {
  awk -v pkg="$2" '
    /^[^ \t#]/ { in_dev = ($0 ~ /^dev_dependencies:/) }
    in_dev && index($0, "  " pkg ":") == 1 { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$1"
}

if [ "$#" -gt 0 ]; then
  members=("$@")
else
  members=()
  while IFS= read -r pubspec; do
    if has_dev_dependency "$pubspec" build_runner ||
      has_dev_dependency "$pubspec" pigeon; then
      m="$(dirname "$pubspec")"
      members+=("${m#./}")
    fi
  done < <(find . -maxdepth 3 -name pubspec.yaml \
    -not -path '*/.dart_tool/*' -not -path '*/build/*' | sort)
fi

if [ "${#members[@]}" -eq 0 ]; then
  echo "no member with build_runner or pigeon in dev_dependencies found" >&2
  exit 1
fi

# Prints "<path><TAB><sha1>" for every generated file of member $1, with paths
# relative to the repo root, sorted. Generated files are *.g.dart and
# *.freezed.dart under lib/ and test/, *.steps.dart under lib/ (drift_dev
# make-migrations' step helper), *.g.kt under android/app/src/ (Pigeon's
# Kotlin output), everything under drift_schemas/ and everything under
# test/drift/ (make-migrations writes its schema helpers there).
# Absent folders are skipped.
hash_generated() {
  local m="$1" d f sum
  local dirs=()
  for d in lib test drift_schemas android/app/src; do
    [ -d "$m/$d" ] && dirs+=("$m/$d")
  done
  [ "${#dirs[@]}" -eq 0 ] && return 0
  find "${dirs[@]}" -type f \( \
    -name '*.g.dart' -o -name '*.freezed.dart' -o -name '*.g.kt' \
    -o -path "$m/lib/*.steps.dart" \
    -o -path "$m/drift_schemas/*" -o -path "$m/test/drift/*" \) -print0 |
    sort -z |
    while IFS= read -r -d '' f; do
      sum="$(shasum "$f")"
      printf '%s\t%s\n' "$f" "${sum%% *}"
    done
}

# Deletes the *.g.dart and *.freezed.dart files under lib/ and test/, the
# *.steps.dart files under lib/, everything in test/drift/*/generated/, and the
# *.g.kt files under android/app/src/, of member $1, so the generators must
# write every one of them again. A file they no longer produce (an orphan) is
# then gone from the "after" hashes and reported as stale; build_runner alone
# would leave it if its build cache is cold. drift_schemas/ and the other files
# in test/drift/ (the hand-written tests) are kept: old schema dumps cannot be
# rebuilt, and make-migrations never rewrites an existing migration_test.dart.
delete_generated_code() {
  local m="$1" d
  for d in lib test; do
    [ -d "$m/$d" ] || continue
    find "$m/$d" -type f \( -name '*.g.dart' -o -name '*.freezed.dart' \) \
      -not -path "$m/test/drift/*" -delete
  done
  [ -d "$m/lib" ] && find "$m/lib" -type f -name '*.steps.dart' -delete
  [ -d "$m/test/drift" ] &&
    find "$m/test/drift" -type f -path "$m/test/drift/*/generated/*" -delete
  [ -d "$m/android/app/src" ] &&
    find "$m/android/app/src" -type f -name '*.g.kt' -delete
  return 0
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

stale=()
for m in "${members[@]}"; do
  if [ ! -f "$m/pubspec.yaml" ]; then
    echo "FAIL: member $m has no pubspec.yaml" >&2
    exit 1
  fi
  echo "==> generated files in $m"
  hash_generated "$m" >"$work/before"
  delete_generated_code "$m"

  # Pigeon first: build_runner then sees the files Pigeon wrote (a .dart file
  # in lib/ may import them).
  if has_dev_dependency "$m/pubspec.yaml" pigeon; then
    for pigeon_input in "$m"/pigeons/*.dart; do
      [ -f "$pigeon_input" ] || continue
      (cd "$m" && "$root/tool/dart" run pigeon --input "pigeons/$(basename "$pigeon_input")")
    done
    # Pigeon does not format its Dart output, but tool/check's format step
    # does: format it here, so the committed file can be both formatted and
    # fresh. Only Pigeon's files exist in lib/ and test/ at this point (the
    # others were deleted above and build_runner has not run yet).
    pigeon_dart=()
    while IFS= read -r -d '' f; do
      pigeon_dart+=("$f")
    done < <(find "$m/lib" "$m/test" -type f -name '*.g.dart' -print0 2>/dev/null)
    if [ "${#pigeon_dart[@]}" -gt 0 ]; then
      "$root/tool/dart" format "${pigeon_dart[@]}"
    fi
  fi
  if has_dev_dependency "$m/pubspec.yaml" build_runner; then
    (cd "$m" && "$root/tool/dart" run build_runner build)
  fi
  if [ -f "$m/build.yaml" ] && grep -q 'databases:' "$m/build.yaml"; then
    (cd "$m" && "$root/tool/dart" run drift_dev make-migrations)
  fi

  hash_generated "$m" >"$work/after"
  while IFS= read -r path; do
    stale+=("$path")
  done < <(awk -F'\t' '
    NR == FNR { before[$1] = $2; next }
    { after[$1] = $2 }
    END {
      for (p in before) if (!(p in after) || before[p] != after[p]) print p
      for (p in after) if (!(p in before)) print p
    }' "$work/before" "$work/after" | sort -u)
done

if [ "${#stale[@]}" -gt 0 ]; then
  for path in "${stale[@]}"; do
    echo "stale: $path"
  done
  echo "generated files were out of date and have been regenerated; review and commit them" >&2
  exit 1
fi
echo "generated files fresh"
