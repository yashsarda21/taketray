      "name": "reels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reels\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"status\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "clips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clips\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source\" TEXT NOT NULL, \"media_store_id\" INTEGER NULL, \"volume_name\" TEXT NULL, \"picker_uri\" TEXT NULL, \"size_bytes\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"date_taken_utc\" INTEGER NOT NULL, \"display_name\" TEXT NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"mime_type\" TEXT NOT NULL, \"time_zone_id\" TEXT NULL, \"generation_added\" INTEGER NULL, \"first_seen_at\" INTEGER NOT NULL, \"missing\" INTEGER NOT NULL DEFAULT 0 CHECK (\"missing\" IN (0, 1)), \"last_verified_at\" INTEGER NULL, UNIQUE (\"volume_name\", \"media_store_id\"), UNIQUE (\"picker_uri\"), CHECK (source <> 'mediaStore' OR (volume_name IS NOT NULL AND media_store_id IS NOT NULL)), CHECK (source <> 'picker' OR picker_uri IS NOT NULL));"
        }
      ]
    },
    {
      "name": "clip_reels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clip_reels\" (\"clip_id\" INTEGER NOT NULL REFERENCES clips (id) ON DELETE CASCADE, \"reel_id\" INTEGER NOT NULL REFERENCES reels (id) ON DELETE CASCADE, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"clip_id\", \"reel_id\"));"
        }
      ]
    },
