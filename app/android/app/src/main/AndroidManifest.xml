<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- TakeTray is fully offline: release builds must never request INTERNET,
         even if a plugin tries to merge it in. debug/ and profile/ manifests
         declare it for hot reload and the debugger. Checked by
         tool/check_release_permissions. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <!-- The video player's ExoPlayer (media3) merges these two in. The viewer
         plays a local file: video_player never sets a wake mode and media3
         treats the network state as optional (D-89). Checked by
         tool/check_release_permissions. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove"/>

    <!-- Reading videos (D-68). Android 11-12 read through READ_EXTERNAL_STORAGE
         (so it stops at maxSdkVersion 32); 13 has READ_MEDIA_VIDEO; 14+ adds
         READ_MEDIA_VISUAL_USER_SELECTED ("Select photos and videos", limited
         access), asked for together with READ_MEDIA_VIDEO. Nothing else
         media-related: no READ_MEDIA_IMAGES, MANAGE_EXTERNAL_STORAGE or
         ACCESS_MEDIA_LOCATION. Checked by tool/check_release_permissions. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>

    <!-- The new-clips notification and the reminders (D-101, D-103). A runtime
         permission from Android 13; below 13 it is granted at install.
         The release gains only this one and RECEIVE_BOOT_COMPLETED (D-101). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Re-arming the new-clips job and the reminder alarms after a reboot
         (D-105): neither survives one. No exact-alarm permission: the
         reminders are inexact (setAndAllowWhileIdle, D-101). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- No Google backup or phone-to-phone transfer of app data (D-64): the
         database holds MediaStore ids that would point at other videos on
         another phone, so a new phone starts with an empty TakeTray. The two XML files exclude every domain; allowBackup is
         off as well. Checked by tool/check_release_permissions. -->
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter's deep linking is off (D-101, D-103): this activity is
                 exported for the launcher, so with it on any app could open
                 any route. Notifications send an allow-listed launch action
                 (background/LaunchActions.kt) instead. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Records time-zone changes while the app is closed (spec §8.3a).
             ACTION_TIMEZONE_CHANGED is exempt from the implicit-broadcast
             limits; the system delivers it to a receiver that is not exported. -->
        <receiver
            android:name=".media.TimeZoneChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
        <!-- Re-arms the job and the reminder alarms (D-105) after a reboot, an
             update of TakeTray and a clock change. Not exported: the system
             still delivers these broadcasts (each is exempt from the
             implicit-broadcast limits, or sent to this app only). -->
        <receiver
            android:name=".background.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>
        <!-- The reminder alarms and Still shooting?'s shade buttons (D-105):
             explicit broadcasts from TakeTray's own PendingIntents only. Not
             exported and no intent filter, so no other app can reach them. -->
        <receiver
            android:name=".background.ReminderReceiver"
            android:exported="false"/>
        <receiver
            android:name=".background.ShadeActionReceiver"
            android:exported="false"/>
        <!-- The new-clips job (D-104): JobScheduler starts it when the video
             library changes, with no Flutter engine. Only the system may
             bind it (BIND_JOB_SERVICE); not exported. -->
        <service
            android:name=".background.NewClipsJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>
        <!-- The settle job (D-110): a one-off job the new-clips job schedules
             while the newest clip is under 5 minutes old. Same rules. -->
        <service
            android:name=".background.NewClipsSettleJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
