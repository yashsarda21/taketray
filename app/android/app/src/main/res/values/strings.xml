<?xml version="1.0" encoding="utf-8"?>
<!-- The notification copy (D-101). Notifications are built without a Flutter
     engine, so they cannot read the ARB; this file is the native mirror of the
     prototype's text, verbatim. English only. Never a file name or a folder
     in a notification (D-10). -->
<resources>
    <!-- Channels: names and descriptions as Android's notification settings show them. -->
    <string name="channel_new_clips_name">New clips</string>
    <string name="channel_new_clips_description">One quiet notification when new clips are waiting to be tagged.</string>
    <string name="channel_reminders_name">Reminders</string>
    <string name="channel_reminders_description">The evening reminder and the Shooting mode reminder.</string>

    <!-- The new-clips notification (D-104). -->
    <plurals name="new_clips_title">
        <item quantity="one">%d new clip to tag</item>
        <item quantity="other">%d new clips to tag</item>
    </plurals>
    <plurals name="new_clips_text">
        <item quantity="one">Tap to tag it into a reel.</item>
        <item quantity="other">Tap to tag them into your reels.</item>
    </plurals>
    <!-- The lock-screen (public) version: the app name and the count, no picture. -->
    <string name="new_clips_public_title">TakeTray</string>
    <string name="action_open_camera">Open camera</string>
    <string name="action_tag_now">Tag now</string>
</resources>
