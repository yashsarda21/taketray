<?xml version="1.0" encoding="utf-8"?>
<!-- The tray (D-137): rises 14 units over 300 ms from the first frame, then
     catches the clips at 700 ms with a 220 ms squash (wider 1.04, shorter
     0.9, peak at 40 % of 220 ms = 88 ms). The squash is two plain two-value
     animators per property, there and back, each with the standard curve (the
     prototype eases each keyframe interval): the hardware path that runs an
     animated vector may sample only the first and last keyframe of a
     keyframe animator, both 1, and the tray would never squash. The rise and
     the fade (splash_fade_tray) start at offset 0, so the first frame already
     shows their start values. Units are the vector's viewport units. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">
    <objectAnimator
        android:propertyName="translateY"
        android:startOffset="0"
        android:duration="300"
        android:valueFrom="14"
        android:valueTo="0"
        android:valueType="floatType"
        android:interpolator="@interpolator/splash_emphasized_decelerate" />
    <objectAnimator
        android:propertyName="scaleX"
        android:startOffset="700"
        android:duration="88"
        android:valueFrom="1"
        android:valueTo="1.04"
        android:valueType="floatType"
        android:interpolator="@interpolator/splash_standard" />
    <objectAnimator
        android:propertyName="scaleX"
        android:startOffset="788"
        android:duration="132"
        android:valueFrom="1.04"
        android:valueTo="1"
        android:valueType="floatType"
        android:interpolator="@interpolator/splash_standard" />
    <objectAnimator
        android:propertyName="scaleY"
        android:startOffset="700"
        android:duration="88"
        android:valueFrom="1"
        android:valueTo="0.9"
        android:valueType="floatType"
        android:interpolator="@interpolator/splash_standard" />
    <objectAnimator
        android:propertyName="scaleY"
        android:startOffset="788"
        android:duration="132"
        android:valueFrom="0.9"
        android:valueTo="1"
        android:valueType="floatType"
        android:interpolator="@interpolator/splash_standard" />
</set>
