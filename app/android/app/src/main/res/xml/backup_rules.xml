<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (API 30): the same rule as data_extraction_rules.xml, in the
     older format. Nothing of TakeTray's is backed up (D-64). drift_flutter
     keeps taketray.sqlite, with its -wal and -shm files, in app_flutter/
     (path_provider's documents directory). Android counts that folder under
     the "root" domain, so "root" is the exclusion that covers the database.
     The other domains are excluded too, so nothing else leaves the phone
     either. The database holds MediaStore ids, which on another phone would
     point at other videos. A new phone starts with an empty TakeTray;
     Export / Import is a same-phone backup, and moving phones is not
     supported in v1. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
