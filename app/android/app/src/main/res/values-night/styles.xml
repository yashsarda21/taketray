<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No LaunchTheme here (D-137): the one in values/ is a Theme.SplashScreen
         child for light and dark, and colors.xml in this folder flips its colours. -->
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    <!-- The share screen's theme (D-163), the same as in values/: it has no
         colour of its own, so dark mode changes nothing. The Flutter sheet
         follows the phone's light or dark setting itself. -->
    <style name="ShareTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
